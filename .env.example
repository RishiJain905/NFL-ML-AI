# Template for the real env file (which is git-ignored and never read by agents).
# Copy this file, rename the copy to drop the ".example" suffix, and fill in values.
# Format: NAME=value, no spaces around "=". No quotes needed for plain values; use
# single quotes if a value contains $, #, spaces or quotes. Use forward slashes in paths.

# --- Required -------------------------------------------------------------
# Data root on the D: drive (documentation/02 -> Storage)
NFL_DATA_ROOT=D:/nfl-ml-data
# Neo4j (Docker). Password must be at least 8 characters.
NEO4J_PASSWORD=
# Weights & Biases
WANDB_API_KEY=

# --- Optional -------------------------------------------------------------
# W&B team/user entity (defaults to your personal entity)
WANDB_ENTITY=
# Neo4j connection overrides (defaults shown)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# Digest LLM through OpenRouter (llm.provider = openrouter in config/settings.yaml)
OPENROUTER_API_KEY=
# Other real LLM providers (P09); not needed for placeholder or openrouter
LLM_API_KEY=
LLM_BASE_URL=
# The Odds API free tier (https://the-odds-api.com/). The second key is a backup,
# used automatically when the first is rejected or out of quota.
ODDS_API_KEY=
ODDS_API_KEY2=
# Kaggle (T00, Big Data Bowl download)
KAGGLE_USERNAME=
KAGGLE_KEY=
# SMTP notifications (P07), names to be finalised then
